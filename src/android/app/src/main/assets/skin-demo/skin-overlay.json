  "accent": "#C9A96A",
  "overlay": "<style>\n.dm-stage{position:fixed;inset:0;overflow:hidden;background:linear-gradient(180deg,#1a1713 0%,#262019 60%,#1a1713 100%);font:13px/1.4 system-ui,sans-serif}\n.dm{position:absolute;left:100%;white-space:nowrap;padding:4px 14px;border-radius:999px;animation:fly linear forwards;box-shadow:0 1px 4px rgba(0,0,0,.4)}\n.dm.a{background:rgba(201,169,106,.16);color:#e8d9b0;border:1px solid rgba(201,169,106,.45)}\n.dm.u{background:rgba(91,140,160,.18);color:#cfe6ee;border:1px solid rgba(91,140,160,.5)}\n.dm small{opacity:.6;margin-right:4px}\n@keyframes fly{to{transform:translateX(-160vw)}}\n.dm-hint{position:fixed;bottom:52px;left:0;right:0;text-align:center;color:#8a7c5c;font-size:11px;letter-spacing:2px}\n</style>\n<div class=\"dm-stage\" id=\"st\"><div class=\"dm-hint\">弹 幕 书 简 · NOVEN</div></div>\n<script>\n(function(){var st=document.getElementById('st');\nfunction render(){var F=window.NOVEN_FRAME||{};var ms=F.messages||[];\nst.querySelectorAll('.dm').forEach(function(e){e.remove()});\nms.slice(-14).forEach(function(m,i){var el=document.createElement('div');\nel.className='dm '+(m.role==='user'?'u':'a');\nel.innerHTML='<small>'+((m.name||m.role||'').slice(0,8))+'</small>'+(m.text||'').slice(0,60).replace(/</g,'&lt;');\nel.style.top=(6+(i%9)*9.5)+'%';el.style.animationDuration=(8+((i*37)%7))+'s';st.appendChild(el);});}\nwindow.addEventListener('noven:frame',render);render();})();\n</script>"
}